# Companion: optional AI for sentences the on-device rules don't understand.
# Copy to .env.local (never commit it). With nothing set, the app works fully on the device.
# These are read ONLY on the server (src/app/api/assistant/route.ts). Never prefix them with NEXT_PUBLIC_.

# anthropic | openai-compatible | openai   (leave empty for on-device only)
AI_PROVIDER=

# Key for the provider. For anthropic you may use ANTHROPIC_API_KEY instead.
AI_API_KEY=

# Model. anthropic default: claude-opus-5-5. Required for openai-compatible (e.g. llama3.2 on Ollama).
AI_MODEL=

# For openai-compatible: the server's /v1 URL, e.g. http://localhost:11434/v1 (Ollama) or http://localhost:1234/v1 (LM Studio).
AI_BASE_URL=
