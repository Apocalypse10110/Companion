# Companion: server-side AI configuration.
# Copy to .env.local (never commit it). With nothing set, the app still works on the device (simple rules only).
# These are read ONLY on the server (src/app/api/assistant/route.ts). Never prefix them with NEXT_PUBLIC_.

# --- Gemini (default testing provider) ---------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey. With this set and AI_PROVIDER empty, Gemini is used.
GEMINI_API_KEY=your_api_key_here

# --- Choosing a provider ----------------------------------------------------------------------
# gemini | anthropic | openai-compatible | openai   (empty = gemini if GEMINI_API_KEY is set, otherwise on-device only)
AI_PROVIDER=

# Key for anthropic / openai providers. For anthropic you may use ANTHROPIC_API_KEY instead.
AI_API_KEY=

# Model. For gemini: a comma-separated list tried in order when one is busy
#   (default: gemini-3.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash).
# anthropic default: claude-opus-5-5. Required for openai-compatible (e.g. llama3.2 on Ollama).
AI_MODEL=

# For openai-compatible: the server's /v1 URL, e.g. http://localhost:11434/v1 (Ollama) or http://localhost:1234/v1 (LM Studio).
AI_BASE_URL=
